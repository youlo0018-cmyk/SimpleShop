<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>LogService.Infrastructure</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <WarningsAsErrors>CS1591</WarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\LogService.Application\LogService.Application.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- 与 ProductService.Infrastructure 同款：走 IHttpClientFactory 托管连接池与 DNS 刷新 -->
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.0" />
    <!-- Configure&lt;T&gt;(IConfigurationSection) 的扩展方法在这里，没有它读配置节要手写一堆样板 -->
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.0" />
  </ItemGroup>
</Project>
