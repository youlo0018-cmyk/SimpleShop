<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>AuthService.Api</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <WarningsAsErrors>CS1591</WarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\AuthService.Infrastructure\AuthService.Infrastructure.csproj" />
    <ProjectReference Include="..\..\Collaboration\Collaboration.Web\Collaboration.Web.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- 版本说明：OpenIddict.AspNetCore 与 Infrastructure 的 OpenIddict.EntityFrameworkCore 必须同版本，
         否则两套 Core 程序集在运行时冲突。 -->
    <PackageReference Include="OpenIddict.AspNetCore" Version="7.7.1" />
    <!-- 仅用于生成 OpenIddict 表结构的迁移脚本；运行期不依赖它（表由 deploy/sql 建）。 -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.3">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

</Project>