<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>AuthService.Infrastructure</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- CS1591: 缺 XML 注释的公开成员。100% 注释是强制规范，宁可编译失败也不放过 -->
    <WarningsAsErrors>CS1591</WarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\AuthService.Domain\AuthService.Domain.csproj" />
    <ProjectReference Include="..\..\Collaboration\Collaboration.Domain\Collaboration.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- 版本说明：
         OpenIddict 三件套必须同版本（Core / EntityFrameworkCore / Models 由 NuGet 传递依赖对齐），
         7.7.1 的 net10.0 目标依赖 EF Core Relational 10.0.11。
         AuthService 是全项目唯一用 EF Core 的服务——OpenIddict 自带 EF Core 存储，
         硬套 FreeSql 会让令牌存储这一小块变成特例代码，不如统一用官方支持的路径（BUSINESS 1.3）。 -->
    <PackageReference Include="OpenIddict.EntityFrameworkCore" Version="7.7.1" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.0" />
  </ItemGroup>

</Project>