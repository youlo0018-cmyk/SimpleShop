# 复制本文件为 deploy/.env 并填入真实值。deploy/.env 已在 .gitignore 中，不会入库。

# AgileConfig 管理台账号（首次初始化接口 POST /admin/InitPassword 设置的密码）
AGILECONFIG_ADMIN_USER=admin
AGILECONFIG_ADMIN_PASSWORD=

# 各微服务在配置中心里的应用密钥（服务只读配置时用 Basic 认证：用户名=AppId，密码=本值）
AGILECONFIG_APP_SECRET=

# 网关与下游服务之间的内部共享口令。网关与所有微服务必须用同一个值。
# 没配的后果：所有 X-Claim-* 请求头被忽略，所有请求按匿名处理，超管接口全 403。
# 生成方式（PowerShell）：
#   $b = New-Object byte[] 32; [System.Security.Cryptography.RandomNumberGenerator]::Fill($b);
#   [Convert]::ToBase64String($b).TrimEnd('=').Replace('+','-').Replace('/','_')
INTERNAL_SERVICE_TOKEN=

