<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <RootNamespace>Collaboration.Domain.Tests</RootNamespace>
  </PropertyGroup>

  <!-- 注意：这里**不要**引用 AuthService.Infrastructure。
       它会通过 Npgsql.EntityFrameworkCore.PostgreSQL 把 Npgsql 拉到 10.x，
       而本项目其余服务走 FreeSql，依赖 Npgsql 5.0.18。
       Npgsql 6+ 禁止把 Kind=UTC 的 DateTime 写进 timestamp without time zone，
       于是 Collaboration.Domain.Tests 里的 FreeSql 用例会集体报错。
       两套 Npgsql 主版本无法在同一个进程共存——只能分服务隔离，测试项目更不能同时引用。 -->
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
    <PackageReference Include="coverlet.collector" Version="6.0.2" />
  </ItemGroup>

  <!-- 注意：这里**不要**引用 AuthService.Infrastructure。
       它会通过 Npgsql.EntityFrameworkCore.PostgreSQL 把 Npgsql 拉到 10.x，
       而本项目其余服务走 FreeSql，依赖 Npgsql 5.0.18。
       Npgsql 6+ 禁止把 Kind=UTC 的 DateTime 写进 timestamp without time zone，
       于是 Collaboration.Domain.Tests 里的 FreeSql 用例会集体报错。
       两套 Npgsql 主版本无法在同一个进程共存——只能分服务隔离，测试项目更不能同时引用。 -->
  <ItemGroup>
    <ProjectReference Include="..\..\src\Collaboration\Collaboration.Domain\Collaboration.Domain.csproj" />
    <ProjectReference Include="..\..\src\PermissionService\PermissionService.Application\PermissionService.Application.csproj" />
    <ProjectReference Include="..\..\src\ToolService\ToolService.Domain\ToolService.Domain.csproj" />
    <ProjectReference Include="..\..\src\ToolService\ToolService.Application\ToolService.Application.csproj" />
    <ProjectReference Include="..\..\src\ToolService\ToolService.Infrastructure\ToolService.Infrastructure.csproj" />
    <!-- 只引用 Domain：纯计算逻辑，不牵扯 EF Core / Npgsql 新版本 -->
    <ProjectReference Include="..\..\src\MarketingService\MarketingService.Domain\MarketingService.Domain.csproj" />
    <!-- 只引用 Domain：纯计算逻辑 -->
    <ProjectReference Include="..\..\src\OrderService\OrderService.Domain\OrderService.Domain.csproj" />
    <ProjectReference Include="..\..\src\OrderService\OrderService.Application\OrderService.Application.csproj" />
  </ItemGroup>

</Project>

