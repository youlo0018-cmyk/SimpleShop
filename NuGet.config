<?xml version="1.0" encoding="utf-8"?>
<!--
  项目级 NuGet 配置。
  原因：开发机全局配置里有企业私有源 nuget.companycn.net，其证书已过期（NotTimeValid），
        且私有阿里云源返回 401。只要这些源参与还原，NuGet 就会报 NU1301 导致还原失败。
  处理：clear 掉继承的源，只保留官方 nuget.org。
  如果将来需要接私有源，在此追加并保证证书有效。
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
  <disabledPackageSources>
    <clear />
  </disabledPackageSources>
</configuration>

